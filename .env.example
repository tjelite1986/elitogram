# Public hostname and origin (writes must carry this Origin header)
APP_HOST=egram.example.com
APP_ORIGIN=https://egram.example.com

# Host folders bind-mounted into the container (must be owned by uid 1000)
MEDIA_HOST_DIR=/srv/elitogram/media
IMPORT_HOST_DIR=/srv/elitogram/import
BACKUP_HOST_DIR=/srv/elitogram/backups

# Required in production: key for the signed 18+ unlock cookie (openssl rand -hex 32)
ADULT_COOKIE_SECRET=

# First admin account, created on first start if no users exist
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Optional tuning
BACKUP_KEEP=7
ADULT_UNLOCK_MINUTES=60
SESSION_DAYS=60
IG_PROFILE_GAP_SEC=90
IG_MAX_POSTS_PER_RUN=24
TIKTOK_MAX_POSTS_PER_RUN=20
IMPORT_MIN_AGE_SEC=120
MAX_UPLOAD_MB=4096

# Optional web push (npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
